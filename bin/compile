#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>
#
# Third South fork of jakeg/heroku-buildpack-bun. Differences from upstream:
# - The bun binary and bun's package cache live in CACHE_DIR, so repeat builds
#   skip the bun download and install packages from local cache.
# - Nothing bun-related is written into the slug (no .heroku/bin, no install
#   cache, no .profile.d). Bun is a build-time tool here.
# - Script failures fail the build (upstream runs them under `set +e`).

set -eo pipefail

BUILD_DIR=${1:-.}
CACHE_DIR=${2:-}
ENV_DIR=${3:-}
BP_DIR=$(cd "$(dirname "${0:-}")"; cd ..; pwd)

source "$BP_DIR/lib/json.sh"

if [ -d "$ENV_DIR" ]; then
  for e in $(ls "$ENV_DIR"); do
    export "$e=$(cat "$ENV_DIR/$e")"
  done
fi

# Allow Bun version pinning via a choice of 3 different files
if [ -f "$BUILD_DIR/.bun-version" ]; then
  BUN_VERSION="$(cat "$BUILD_DIR/.bun-version")"
elif [ -f "$BUILD_DIR/runtime.bun.txt" ]; then
  BUN_VERSION="$(cat "$BUILD_DIR/runtime.bun.txt")"
elif [ -f "$BUILD_DIR/runtime.txt" ]; then
  BUN_VERSION="$(cat "$BUILD_DIR/runtime.txt")"
fi
BUN_VERSION="$(echo "$BUN_VERSION" | tr -d '[:space:]')"
if [[ $BUN_VERSION =~ ^[0-9] ]]; then
  BUN_VERSION="v${BUN_VERSION}"
fi

# Only a pinned version is cacheable; "latest" changes under us.
export BUN_INSTALL="$CACHE_DIR/bun/${BUN_VERSION:-latest}"
if [[ -n $BUN_VERSION && -x "$BUN_INSTALL/bin/bun" ]]; then
  echo "Using cached Bun $BUN_VERSION"
else
  echo "Installing Bun ${BUN_VERSION:-latest}"
  rm -rf "$CACHE_DIR/bun"
  BUN_INSTALL_ARGS=()
  if [[ -n $BUN_VERSION ]]; then
    BUN_INSTALL_ARGS=(-s "bun-$BUN_VERSION")
  fi
  curl -fsSL --retry-connrefused --retry 3 https://bun.sh/install | bash "${BUN_INSTALL_ARGS[@]}"
fi
export PATH="$BUN_INSTALL/bin:$PATH"
export BUN_INSTALL_CACHE_DIR="$CACHE_DIR/bun-install-cache"
echo "Bun $(bun --version)"

# Let subsequent buildpacks call bun during the build.
echo "export PATH=\"$BUN_INSTALL/bin:\$PATH\"" >> "$BP_DIR/export"
echo "export BUN_INSTALL_CACHE_DIR=\"$BUN_INSTALL_CACHE_DIR\"" >> "$BP_DIR/export"

cd "$BUILD_DIR"

if [[ -f package.json && ! -f .skip-bun-install ]]; then
  echo "Installing dependencies..."
  if [[ -f bun.lock || -f bun.lockb ]]; then
    bun install --frozen-lockfile
  else
    bun install
  fi
fi

for script in heroku-prebuild build heroku-postbuild; do
  if [[ -f package.json && "$(has_script "package.json" "$script")" == "true" && ! -f ".skip-bun-$script" ]]; then
    echo "Running $script..."
    bun run "$script"
  fi
done
